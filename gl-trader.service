[Unit]
Description=GoldLegend Exness Trader Service
After=network.target

[Service]
Type=simple
User=gl-trader
WorkingDirectory=/opt/gl-trader
Environment="CONFIG_PATH=/etc/gl-trader/config.toml"
Environment="RUST_LOG=info"
ExecStart=/usr/local/bin/gl-server
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
